{
  "name": "world-overcomers-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The World Overcomers' Ministries Inc. website. React + TypeScript, served by Vite.",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "vite",
    "dev:fresh": "vite --force",
    "serve": "node scripts/serve.mjs",
    "build": "vite build && node scripts/build-static.mjs",
    "predev": "node scripts/check-install.mjs",
    "prebuild": "node scripts/check-install.mjs && node scripts/fix-perms.mjs",
    "fix-perms": "node scripts/fix-perms.mjs",
    "verify": "node scripts/check-install.mjs",
    "bake-seed": "node scripts/bake-seed.mjs",
    "bake-recent": "node scripts/bake-recent.mjs",
    "backup": "node scripts/backup-data.mjs backup",
    "expose": "node scripts/expose.mjs",
    "share-on": "node scripts/share.mjs on",
    "share-off": "node scripts/share.mjs off",
    "autostart": "node scripts/install-autostart.mjs",
    "restore": "node scripts/backup-data.mjs restore",
    "adopt": "node scripts/backup-data.mjs adopt",
    "set-server": "node scripts/set-server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "framer-motion": "11.11.9",
    "qrcode-generator": "1.4.4",
    "swiper": "14.3.0",
    "three": "0.170.0",
    "@react-three/fiber": "8.18.0",
    "@react-three/drei": "9.122.0",
    "vite": "6.4.3",
    "@vitejs/plugin-react": "4.3.4",
    "zustand": "^5.0.1"
  },
  "overrides": {
    "three-mesh-bvh": "^0.8.0"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "typescript": "5.6.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
