{
  "name": "world-overcomers-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The World Overcomers' Ministries Inc. website. Static React bundle (src/bundle.js + src/bundle.css); no runtime dependencies.",
  "scripts": {
    "start": "node scripts/serve.mjs",
