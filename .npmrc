# Quiet npm's own "new version available" notice inside this folder (note 292).
# It is only advertising — installs work the same either way — and it confused
# the office into thinking something was broken. To update npm itself anyway:
# npm install -g npm@latest (after `nvm use`, so it lands on Node 24).
update-notifier=false
# Hide npm's warnings on every install (including the host's unknown
# "cache-dir" env warning, which comes from the deploy platform, not this
# code). Errors still show. Remove this line if warnings are ever wanted back.
loglevel=error
