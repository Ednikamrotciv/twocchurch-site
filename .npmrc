# Quiet npm's own "new version available" notice inside this folder.
# It is only advertising — installs work the same either way. To update npm
# itself anyway: npm install -g npm@latest.
update-notifier=false
# NOTE (install-fix): do NOT set loglevel=error here. It hid the real reason
# `npm install` failed (only "A complete log..." was shown, never the cause).
# The default warn level shows errors AND the reason. Speed-only tweaks below.
fund=false
audit=false
engine-strict=false
